.superpowers/

# Dependencies
node_modules/

# Build output
dist/
build/
apps/web/dist/

# Playwright e2e artifacts
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# Go
/keyhole
/keyhole.exe
*.test

# Local data — never commit a vault database
*.db
*.db-wal
*.db-shm
/data/
config.yml

